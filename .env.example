# Valores locais de exemplo. Nenhum segredo real.
#
# Copiar para .env é opcional: o docker-compose.yml e os testes de integração
# têm padrões iguais a estes. O .env serve para:
#   - rodar a aplicação ou os testes no host (fora do Docker), com endereços localhost;
#   - sobrescrever senhas e nomes usados pelo Compose.
# Dentro do Compose, a app usa os nomes de serviço (postgres, localstack, keycloak).

# Aplicação
APP_HTTP_ADDR=:8081
APP_INSTANCE_ID=local-1
APP_SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=info

# Componentes desta instância (ADR 0002). Pelo menos um ligado.
APP_ENABLE_HTTP=true
APP_ENABLE_SQS_CONSUMER=true
APP_ENABLE_OUTBOX_PUBLISHER=true
APP_ENABLE_PENDING_WORKER=true

# PostgreSQL
# postgres:     superusuário do container, usado só pelo initdb
# app_migrator: dono do schema, usado apenas nas migrations
# app_runtime:  usuário da aplicação
# Mudar senhas exige recriar o volume (make clean): o initdb só roda com volume vazio.
POSTGRES_PASSWORD=postgres
APP_MIGRATOR_PASSWORD=app_migrator
APP_RUNTIME_PASSWORD=app_runtime
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/wager_wallet?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://app_migrator:app_migrator@localhost:5432/wager_wallet?sslmode=disable
DB_LOCK_TIMEOUT=3s

# SQS (LocalStack 4.14.0, sem auth token; ADR 0008)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_INPUT_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo

# OIDC (Keycloak). Sem discovery: iss comparado como texto e JWKS direto (ADR 0009).
# No host, as duas URLs usam localhost:8180; no Compose, o JWKS usa keycloak:8080.
OIDC_ISSUER_URL=http://localhost:8180/realms/wager
OIDC_JWKS_URL=http://localhost:8180/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-wallet-service
KEYCLOAK_ADMIN_PASSWORD=admin

# Clients de teste do realm (deploy/keycloak/realm-wager.json). Apenas para testes locais.
PROVIDER_A_CLIENT_SECRET=provider-a-secret
PROVIDER_B_CLIENT_SECRET=provider-b-secret
WALLET_INTERNAL_CLIENT_SECRET=wallet-internal-secret

# Testes de integração
APP_BASE_URL=http://localhost:8081
# Superusuário, usado só pelo teste de ida e volta das migrations (cria um banco temporário).
POSTGRES_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
